<Project Sdk="Microsoft.NET.Sdk">
  <!-- Checks of the Metal renderer that draw off screen on this Mac's GPU: every shader translates and compiles, and a frame of the
       scene, the UI and each post-process effect comes out as it should. Run it with dotnet run in this folder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EmpireBundleMetal>true</EmpireBundleMetal>
  </PropertyGroup>
  <ItemGroup>
    <!-- the editor's own interface and the sprite editor, drawn here with a fake window and mouse -->
    <Compile Include="..\Editor\Ui\*.cs;..\Editor\Sprites\*.cs;..\Editor\SafeLabel.cs" Link="Editor\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.2" />
    <Using Include="Engine.Brutal.Ui" />
    <Using Include="Engine.Brutal.Gfx" />
    <Using Include="Editor.Ui" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Engine.Brutal\Engine.Brutal.csproj" />
  </ItemGroup>
</Project>
