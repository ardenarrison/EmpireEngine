<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- The hub's release catalog and installer: plain .NET, so they are tested here rather than through the hub's windows. -->
    <Compile Include="../Hub/Releases/*.cs" Link="HubReleases/%(Filename)%(Extension)" />
    <!-- and the hub's project file and settings, which are plain .NET too -->
    <Compile Include="../Hub/EmpireProject.cs;../Hub/HubJson.cs;../Hub/HubSettings.cs;../Hub/Credits.cs;../Hub/EditorInstall.cs" Link="HubFiles/%(Filename)%(Extension)" />
    <!-- the editor's AI assistant: the API client, key storage and prompts are plain .NET, so they are tested here -->
    <Compile Include="../Editor/Assistant/Assistant*.cs" Link="EditorAssistant/%(Filename)%(Extension)" Exclude="../Editor/Assistant/AssistantWindow.cs" />
    <!-- and the editor's built-in terminal: the screen emulator and the shell hosting are plain .NET -->
    <Compile Include="../Editor/Terminal/TerminalEmulator.cs;../Editor/Terminal/PtySession.cs" Link="EditorTerminal/%(Filename)%(Extension)" />
    <!-- and the visual scripting blocks and the C# they turn into -->
    <Compile Include="../Editor/VisualCode/Model/*.cs;../Editor/VisualCode/Blocks/*.cs;../Editor/VisualCode/Transpiler/*.cs" Link="EditorVisualCode/%(Filename)%(Extension)" />
    <!-- and the editor's per-project settings -->
    <Compile Include="../Editor/ProjectSettings.cs" Link="EditorProject/%(Filename)%(Extension)" />
    <!-- and how the editor picks its light or dark look -->
    <Compile Include="../Editor/Ui/ThemeChoice.cs;../Editor/Terminal/TerminalGlyphs.cs" Link="EditorUi/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Engine.Core/Engine.Core.csproj" />
    <ProjectReference Include="../ScriptCompiler/ScriptCompiler.csproj" />
  </ItemGroup>
</Project>
