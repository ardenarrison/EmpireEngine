<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EmpireHub.ConfirmWindow"
        Icon="avares://EmpireHub/Assets/EmpireEngineIcon.ico"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24,20,24,18" Spacing="14">
    <TextBlock x:Name="TitleText" Classes="title" TextWrapping="Wrap" />
    <TextBlock x:Name="MessageText" Classes="dim" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,6,0,0">
      <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" />
      <Button x:Name="ConfirmButton" Classes="accent" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
