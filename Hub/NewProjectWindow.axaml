<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:EmpireHub"
        x:Class="EmpireHub.NewProjectWindow"
        Title="New project"
        Icon="avares://EmpireHub/Assets/EmpireEngineIcon.ico"
        Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="6">
    <TextBlock Classes="title" Text="New project" Margin="0,0,0,12" />

    <TextBlock Text="Name" />
    <TextBox x:Name="NameBox" Text="My Game" TextChanged="OnInputChanged" />

    <TextBlock Text="Location" Margin="0,10,0,0" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="LocationBox" TextChanged="OnInputChanged" />
      <Button Grid.Column="1" Content="Browse..." Margin="8,0,0,0" Click="OnBrowse" />
    </Grid>
    <TextBlock x:Name="PathPreview" Classes="dim" TextTrimming="CharacterEllipsis" />

    <TextBlock Text="Empire Engine version" Margin="0,10,0,0" />
    <ComboBox x:Name="VersionBox" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="local:EditorInstall">
          <TextBlock>
            <Run Text="Empire Engine " /><Run Text="{Binding Version}" />
          </TextBlock>
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <TextBlock x:Name="ErrorText" Classes="error" TextWrapping="Wrap" Margin="0,8,0,0" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
      <Button x:Name="CreateButton" Content="Create" Classes="accent" IsDefault="True" Click="OnCreate" />
    </StackPanel>
  </StackPanel>
</Window>
