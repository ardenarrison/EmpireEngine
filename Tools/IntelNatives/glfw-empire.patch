+{
+    _GLFW_REQUIRE_INIT_OR_RETURN(NULL);
+    _GLFWwindow* window = (_GLFWwindow*) handle;
+    assert(window != NULL);
+    _GLFW_SWAP(GLFWscrolldetailfun, window->callbacks.scrollDetail, cbfun);
+    return cbfun;
+}
