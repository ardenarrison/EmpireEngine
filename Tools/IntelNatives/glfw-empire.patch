+    int flags = 0;
+    if ([event hasPreciseScrollingDeltas])
+        flags |= GLFW_SCROLL_PRECISE;
+    if ([event phase] & NSEventPhaseBegan)
+        flags |= GLFW_SCROLL_BEGIN;
+    if ([event phase] & (NSEventPhaseEnded | NSEventPhaseCancelled))
+        flags |= GLFW_SCROLL_END;
+    if ([event momentumPhase] != NSEventPhaseNone)
+        flags |= GLFW_SCROLL_MOMENTUM;
+    if ([event momentumPhase] & (NSEventPhaseEnded | NSEventPhaseCancelled))
+        flags |= GLFW_SCROLL_END;
+    _glfwInputScrollDetail(window, deltaX, deltaY, flags);
+
     if (fabs(deltaX) > 0.0 || fabs(deltaY) > 0.0)
         _glfwInputScroll(window, deltaX, deltaY);
 }
 
+- (void)magnifyWithEvent:(NSEvent *)event
+{
+    _glfwInputTrackpadZoom(window, 1.0 + [event magnification]);
+}
+
+- (void)rotateWithEvent:(NSEvent *)event
+{
+    // NSEvent's rotation is in degrees, positive counter-clockwise
+    _glfwInputTrackpadRotate(window, [event rotation]);
+}
