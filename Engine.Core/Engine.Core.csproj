    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="NLayer" Version="3.0.0" />
    <PackageReference Include="StbImageSharp" Version="2.30.15" />
